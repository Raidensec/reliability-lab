      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [{"expr": "((sum(rate(reliability_business_requests_total{status=~\"5xx|other\"}[5m])) or vector(0)) / sum(rate(reliability_business_requests_total[5m]))) and (sum(rate(reliability_business_requests_total[5m])) > 0)", "legendFormat": "server error ratio", "refId": "A"}],
